# Indiekit Configuration - Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Publication
PUBLICATION_URL=https://yourdomain.com

# GitHub
GITHUB_USER=your_github_username
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Mastodon
MASTODON_URL=https://mastodon.social
MASTODON_USER=your_mastodon_handle
MASTODON_ACCESS_TOKEN=your_mastodon_app_token_here

# MongoDB
MONGO_URL=mongodb://username:password@host:port/database

# Secrets (use strong random strings)
PASSWORD_SECRET=generate_a_random_string_here
SECRET=generate_another_random_string_here
